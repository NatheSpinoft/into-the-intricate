# Composer dependencies (if you use Composer)
vendor/

# Database files (do not commit credentials or local DB files)
db/database.php
*.sqlite
*.sql

# OS generated files
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
*.iml

# Logs and temporary files
*.log
tmp/
cache/

# Node or frontend build files (if you have React or JS)
node_modules/
build/
dist/

# Environment config files (never commit secrets)
.env
.env.local
.env.*.local

# Misc
*.bak
*.swp
